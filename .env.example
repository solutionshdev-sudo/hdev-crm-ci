# Copie esse arquivo pra `.env` e preencha só o que for usar.
# O `.env` é ignorado pelo git — NUNCA comite chaves reais.

# --- Geração de imagem (skill /carrossel com foto IA) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Publicação Instagram + Facebook (skill /aprovar-post) ---
# Token de longa duração da Página do Facebook (Meta App > Graph API)
META_PAGE_ACCESS_TOKEN=
# ID da Página do Facebook
META_PAGE_ID=
# ID da conta Instagram Business conectada à Página
META_IG_USER_ID=

# --- Site (usado pra montar URLs públicas das imagens) ---
# Sem barra no final. Ex: https://minhaempresa.com.br
SITE_URL=
