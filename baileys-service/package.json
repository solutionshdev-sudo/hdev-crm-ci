{
  "name": "hdev-baileys-service",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp não-oficial (Baileys) para o Hdev CRM — multi-instância, proxy por instância, webhook assinado",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/translate/inbound.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "fastify": "^5.2.0",
    "https-proxy-agent": "^7.0.6",
    "pino": "^9.5.0",
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
