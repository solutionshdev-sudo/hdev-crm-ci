# Porta HTTP interna (não expor publicamente — só a rede interna do compose)
PORT=3025

# Segredo compartilhado com o Rails (mesmo valor de BAILEYS_API_KEY no app)
BAILEYS_API_KEY=troque-por-um-hex-longo

# Onde as sessões (credenciais Baileys + config.json) são persistidas
SESSIONS_DIR=/data/sessions
