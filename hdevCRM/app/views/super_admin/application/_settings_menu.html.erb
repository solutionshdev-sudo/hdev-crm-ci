<li class="px-4 mb-0.5">
  <details class="group" <%= 'open' if open %>>
    <summary class="flex items-center px-2 py-1.5 cursor-pointer rounded-lg text-sm transition-colors duration-150 <%= open ? 'bg-n-blue-3 text-n-blue-11 font-medium' : 'text-n-slate-11 hover:text-n-slate-12 hover:bg-n-slate-3' %> list-none">
      <%= link_to super_admin_settings_url, class: 'flex items-center flex-1' do %>
        <svg width="16" height="16" class="flex-shrink-0"><use xlink:href="#icon-settings-2-line" /></svg>
        <span class="ml-2">Configurações</span>
      <% end %>
      <svg class="ml-auto w-4 h-4 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </summary>
    <ul class="ml-4 mt-1 border-n-slate-4 border-l pl-2">
      <% settings_pages.each do |_feature_key, attrs| %>
        <% url = super_admin_app_config_url(config: attrs['config_key']) %>
        <li class="mb-0.5">
          <% text_class = current_page?(url) ? 'bg-n-blue-3 text-n-blue-11 font-medium' : 'text-n-slate-11 hover:text-n-slate-12 hover:bg-n-slate-3' %>
          <%= link_to url, class: text_class + ' flex items-center px-2 py-1.5 rounded-lg text-sm transition-colors duration-150' do %>
            <span><%= attrs['name'] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
</li>
