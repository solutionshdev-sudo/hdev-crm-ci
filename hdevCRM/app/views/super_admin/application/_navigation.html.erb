<%#
# Navigation

This partial is used to display the navigation in Administrate.
By default, the navigation contains navigation links
for all resources in the admin dashboard,
as defined by the routes in the `admin/` namespace
%>

<%= vite_client_tag %>
<%= vite_javascript_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    agencies: 'icon-briefcase-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
    platform_banners: 'icon-megaphone-line',
  }
%>

<div class="bg-n-slate-2 border-n-slate-6 border-r w-56 flex-shrink-0 justify-between h-full flex flex-col" role="navigation">
  <div>
    <div class="flex mx-4 mb-4 border-n-slate-6 border-b py-6">
      <%= link_to image_tag('/brand-assets/logo_thumbnail.svg', alt: 'Hdev CRM Admin Dashboard', class: 'h-10'), super_admin_root_url %>
      <div class="flex flex-col ml-3">
        <div class="text-sm font-medium text-n-slate-12">Hdev CRM <%= HdevCrm.config[:version] %></div>
        <div class="text-xs text-n-slate-11 mt-0.5">Console do Super Admin</div>
      </div>
    </div>

    <ul class="my-4">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Painel' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if ["account_users", "agency_users", "access_tokens", "installation_configs", "dashboard", "devise/sessions", "app_configs", "instance_statuses", "settings", "push_diagnostics"].include?  resource.resource %>
        <% next if resource.resource == "platform_banners" && !HdevApp.chatwoot_cloud? %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: display_resource_name(resource),
          }
        %>

      <% end %>
      <%= render 'settings_menu', open: settings_open? %>
    </ul>
  </div>
  <div>
    <ul class="my-4">
      <li class="px-4 mb-1">
        <%# Switch compacto: o estado visual vem das variantes dark: — o pill
            está "ligado" exatamente quando .dark está no root. %>
        <button type="button" onclick="toggleSaTheme()" class="w-full flex items-center justify-between px-2 py-1.5 rounded-lg text-sm text-n-slate-11 hover:text-n-slate-12 hover:bg-n-slate-3 transition-colors duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-n-blue-8">
          <span class="flex items-center">
            <svg width="16" height="16" class="flex-shrink-0"><use xlink:href="#icon-contrast-line" /></svg>
            <span class="ml-2">Tema escuro</span>
          </span>
          <span id="sa-theme-switch" role="switch" aria-checked="false" aria-label="Alternar tema claro/escuro" class="relative inline-block h-5 w-9 flex-shrink-0 rounded-full bg-n-slate-6 dark:bg-n-blue-9 transition-colors duration-150">
            <span class="absolute top-0.5 left-0.5 dark:left-[1.125rem] h-4 w-4 rounded-full bg-white shadow-sm transition-all duration-150"></span>
          </span>
        </button>
      </li>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Filas (Sidekiq)' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Saúde da instância' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mail-send-fill', url: super_admin_push_diagnostics_url, label: 'Diagnóstico de push' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Painel do agente' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Sair' } %>
    </ul>
  </div>
</div>
