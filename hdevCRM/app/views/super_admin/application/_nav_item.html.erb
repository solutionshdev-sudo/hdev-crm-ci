<li class="px-4 mb-0.5">
  <% link_classes = current_page?(url) ? 'bg-n-blue-3 text-n-blue-11 font-medium' : 'text-n-slate-11 hover:text-n-slate-12 hover:bg-n-slate-3' %>
  <%= link_to(url, class: link_classes + " flex items-center px-2 py-1.5 rounded-lg text-sm transition-colors duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-n-blue-8") do %>
    <svg width="16" height="16" class="flex-shrink-0"><use xlink:href="#<%= icon %>" /></svg>
    <span class="ml-2"><%= label %></span>
  <% end %>
</li>
