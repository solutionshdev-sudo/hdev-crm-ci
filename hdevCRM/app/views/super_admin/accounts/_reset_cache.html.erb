<section class="main-content__body">
 <hr/>
  <%= form_for([:reset_cache, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
    <div class="form-actions">
      <p class="pb-3">Isso limpa as chaves de cache do IndexedDB no Redis. <br>O próximo carregamento buscará os dados do backend.</p>
      <%= f.submit 'Limpar cache do frontend' %>
    </div>
  <% end %>
</section>
