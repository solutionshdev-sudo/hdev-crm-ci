<%#
# Application Layout

This view template is used as the layout
for every page that Administrate generates.

By default, it renders:
- Navigation
- Content for a search bar
  (if provided by a `content_for` block in a nested page)
- Flashes
- Links to stylesheets and JavaScripts
%>

<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="w-full h-full">
<head>
  <meta charset="utf-8">
  <meta name="ROBOTS" content="NOODP">
  <meta name="viewport" content="initial-scale=1">
  <title>
    <%# application_title da gem derivaria do módulo Rails ("Chatwoot") — marca fixa aqui %>
    <%= content_for(:title) %> - Hdev CRM
  </title>
  <script>
    // Tailwind's dark: variants only fire when `.dark` sits on the root
    // element. Escolha manual (localStorage) vence; sem escolha, segue o sistema.
    var saTheme = localStorage.getItem('sa_theme');
    if (saTheme === 'dark' || (!saTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    }
    function toggleSaTheme() {
      var dark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('sa_theme', dark ? 'dark' : 'light');
      syncSaThemeToggle();
    }
    function syncSaThemeToggle() {
      var el = document.getElementById('sa-theme-switch');
      if (el) el.setAttribute('aria-checked', document.documentElement.classList.contains('dark'));
    }
    document.addEventListener('DOMContentLoaded', syncSaThemeToggle);
  </script>
  <%= render "stylesheet" %>
  <%= vite_client_tag %>
  <%= vite_javascript_tag 'superadmin' %>
  <%= csrf_meta_tags %>
</head>
<body class="antialiased w-full h-full bg-n-slate-1 text-n-slate-12">
  <%= render "icons" %>
  <div class="flex w-full h-full">
    <%= render "navigation" -%>
    <main class="w-full overflow-auto" role="main">
      <%= render "flashes" -%>
      <%= yield %>
    </main>
  </div>
  <%= render "javascript" %>
</body>
</html>
